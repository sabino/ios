  "record": {
    "id": "E03",
    "title": "Entry is a state contract",
    "environment": "PinePhone QEMU",
    "method": "Reference handoff capture and bounded unchanged-kernel entry trace",
    "observation": "The common ARMv6 kernel enters its bootstrap and reaches arm_init on the A53 model, then faults at an ARM1176-specific peripheral remap register access.",
    "limits": "This entry diagnostic does not establish a kernel boot. The M68AP-tree trial still uses reference boot arguments captured from N45AP.",
