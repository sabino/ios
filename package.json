{
  "name": "iphone-os-research-atlas",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/validate-content.mjs && astro build && node scripts/check-site.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:hero": "node scripts/hero-check.mjs",
    "test:status": "node scripts/status-check.mjs",
    "test:evidence": "node scripts/evidence-check.mjs",
    "test:reading": "node scripts/reading-paths-check.mjs",
    "test:focus": "node scripts/status-focus-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2"
  }
}
