---
// Original illustrative device frames. Genuine QEMU pixels stay labeled by substrate.
import {url} from '../lib/content';
const {variant = 'full'} = Astro.props;
const referenceShot = url('evidence/images/E28-reference-home.png');
const shot = url('evidence/images/E43-313-lock-qemu.png');
---
<div class={'showcase showcase--' + variant} data-showcase>
  <div class="showcase-head"><span>THE SOFTWARE</span><span aria-hidden="true">→</span><span>THE NATIVE TARGET</span></div>
  <div class="stage">
    <figure class="device slab-device ipod" style="--i:0">
      <div class="device-bob"><div class="slab" data-tilt>
        <div class="screen"><img src={referenceShot} alt="Reviewed 4A102 iPod reference home screen, E28" width="320" height="480" loading="eager" decoding="async"/></div>
        <span class="home-btn" aria-hidden="true"></span>
      </div></div>
      <figcaption><strong>iPod touch</strong><span class="mono">N45AP · 1.1.4</span></figcaption>
    </figure>
    <figure class="device pinephone hero-device" style="--i:1">
      <div class="device-bob"><div class="pp-body" data-tilt>
        <span class="pp-ear" aria-hidden="true"></span><span class="pp-cam" aria-hidden="true"></span>
        <div class="pp-screen"><div class="pp-fit"><img src={shot} alt="7E18 QEMU lock screen illustrated at 2× scale within the PinePhone panel" width="320" height="480" loading="eager" decoding="async"/></div></div>
      </div></div>
      <figcaption><strong>PinePhone</strong><span class="mono">A64 · 3.1.3 native</span></figcaption>
    </figure>
    <figure class="device slab-device iphone" style="--i:2">
      <div class="device-bob"><div class="slab" data-tilt>
        <span class="earpiece" aria-hidden="true"></span>
        <div class="screen"><img src={shot} alt="7E18 QEMU lock screen in an illustrative original iPhone frame" width="320" height="480" loading="eager" decoding="async"/></div>
        <span class="home-btn" aria-hidden="true"></span>
      </div></div>
      <figcaption><strong>iPhone</strong><span class="mono">M68AP · 3.1.3</span></figcaption>
    </figure>
  </div>
  <p class="showcase-note">Illustrative frames · genuine <a href={url('evidence/E28/#reference-home')}>4A102 reference ↗</a> and <a href={url('evidence/E43/')}>7E18 QEMU pixels ↗</a><span>QEMU images do not prove physical behavior · <a href={url('evidence/E51/')}>owner acceptance E51 ↗</a></span></p>
</div>

<style>
  .showcase{--slab:#181c23;--slab-hi:#353b46;width:100%;max-width:820px;min-width:0}
  .showcase-head{display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid var(--rule);padding-bottom:15px;margin-bottom:36px;font:10px var(--mono);color:var(--muted)}
  .showcase-head>span:nth-child(2){margin-left:auto;font-size:15px}
  .stage{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.45fr) minmax(0,1fr);align-items:end;gap:clamp(12px,2.2vw,32px);perspective:1400px}
  .device{margin:0;display:flex;flex-direction:column;align-items:center;gap:18px;min-width:0}
  .device-bob{width:100%;display:grid;place-items:center}
  .device figcaption{display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center;min-height:40px}
  .device figcaption strong{font-size:13px;font-weight:600;white-space:nowrap}
  .device figcaption .mono{font-size:9px;color:var(--muted);white-space:nowrap}
  .slab{position:relative;width:100%;max-width:150px;aspect-ratio:61/115;background:linear-gradient(145deg,var(--slab-hi),var(--slab) 65%);border-radius:clamp(12px,1.5vw,20px);box-shadow:0 23px 32px -23px #091524b0,inset 0 0 0 1px #ffffff25;transition:transform .5s var(--ease-out)}
  .ipod .slab{border:2px solid #8c939b}
  .earpiece{position:absolute;top:7.5%;left:38%;width:24%;height:3px;border-radius:3px;background:#07090c}
  .home-btn{position:absolute;bottom:5%;left:42.5%;width:15%;aspect-ratio:1;border-radius:50%;border:1px solid #737a83;background:#10141a;display:grid;place-items:center}
  .home-btn:after{content:'';width:35%;height:35%;border:1px solid #89909a;border-radius:2px}
  .screen{position:absolute;top:16%;left:8%;width:84%;aspect-ratio:2/3;background:#000;border-radius:2px;overflow:hidden}
  .screen img,.pp-fit img{width:100%;height:100%;object-fit:contain;display:block}
  .pp-body{position:relative;width:100%;max-width:228px;aspect-ratio:766/1605;background:linear-gradient(145deg,var(--slab-hi),var(--slab) 65%);border-radius:clamp(15px,2vw,27px);box-shadow:0 30px 40px -26px #091524b0,inset 0 0 0 1px #ffffff25;transition:transform .5s var(--ease-out)}
  .pp-ear{position:absolute;top:3%;left:40%;width:20%;height:3px;border-radius:3px;background:#080a0e}
  .pp-cam{position:absolute;top:2.8%;right:23%;width:4px;height:4px;border-radius:50%;background:#05060a;box-shadow:0 0 0 2px #ffffff0d}
  .pp-screen{position:absolute;top:6%;left:5%;width:90%;aspect-ratio:1/2;background:#000;border-radius:5px;overflow:hidden;display:grid;place-items:center}
  .pp-fit{width:88.8889%;height:66.6667%}
  .showcase-note{font-size:10px;line-height:1.8;color:var(--muted);text-align:center;margin:28px 0 0}
  .showcase-note a{color:var(--blue);text-decoration:underline;text-underline-offset:3px}.showcase-note a:hover{text-decoration:underline}
  .showcase-note>span{display:block;font:9px/1.8 var(--mono);margin-top:4px}
  .showcase--hero .showcase-head{margin-bottom:36px}
  .showcase.is-entering .device{animation:device-arrive .8s var(--ease-out) backwards;animation-delay:calc(var(--i)*120ms)}
  .showcase.in-view .device-bob{animation:device-float 7s ease-in-out infinite;animation-delay:calc(var(--i)*-.8s)}
  .showcase:is(:hover,:focus-within) .device-bob{animation-play-state:paused}
  @keyframes device-arrive{from{opacity:0;transform:translateY(20px) scale(.97)}to{opacity:1;transform:none}}
  @keyframes device-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
  @media(hover:hover){.slab[data-tilt]:hover,.pp-body[data-tilt]:hover{transform:rotateX(4deg) rotateY(-6deg) translateY(-4px)}}
  @media(max-width:600px){.showcase{padding-top:14px}.stage{gap:12px}.showcase-head{font-size:9px;gap:10px;margin-bottom:28px}.device{gap:14px}.device figcaption strong{font-size:11px}.device figcaption .mono{font-size:8px}.showcase-note{font-size:9px;margin-top:20px}.showcase-note>span{font-size:8px}.showcase--hero{align-self:center}}
  @media(prefers-reduced-motion:reduce){.showcase.is-entering .device,.showcase.in-view .device-bob{animation:none}.slab,.pp-body{transition:none}.slab[data-tilt]:hover,.pp-body[data-tilt]:hover{transform:none}}
</style>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-showcase]')) {
    let inViewport = false;
    const updateVisibility = () => {
      const active = inViewport && !el.closest<HTMLElement>('[data-hero-slide]')?.inert;
      el.classList.toggle('in-view', active);
      if (active && !el.dataset.entered) {
        el.dataset.entered = 'true'; el.classList.add('is-entering');
        window.setTimeout(() => el.classList.remove('is-entering'), 1200);
      }
    };
    const observer = new IntersectionObserver((entries) => {
      inViewport = entries[0].isIntersecting;
      updateVisibility();
    }, {threshold: .1});
    el.closest('[data-hero-slide]')?.addEventListener('atlas:hero-visibility', updateVisibility);
    observer.observe(el);
  }
</script>
