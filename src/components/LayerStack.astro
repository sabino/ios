---
import {articles, sections, sectionDescriptions, url} from '../lib/content';
import CapabilityRow from './CapabilityRow.astro';
import ArchitectureIcon from './ArchitectureIcon.astro';
import StatusSpotlight from './StatusSpotlight.astro';
import {capabilityKey} from '../lib/capability-focus';
import '../styles/status-lens.css';
import caps from '../data/capabilities.json';
const {id = 'atlas-layers', capabilities = false} = Astro.props;
const areaLabels: Record<string, string> = {system: 'System', input: 'Input', camera: 'Camera', power: 'Power', display: 'Display', performance: 'Performance', connections: 'Connections'};
const categoryAreas: Record<string, string> = {'Boot & core': 'system', Graphics: 'display', Interaction: 'input', 'Camera (M68AP)': 'camera', Power: 'power', Performance: 'performance', 'Not yet connected': 'connections'};
const features = caps.domains.flatMap(domain => domain.features.map(feature => ({...feature, category: domain.name, area: feature.feature === 'Screenshots' ? 'display' : categoryAreas[domain.name]})));
const areaOrder = ['input', 'camera', 'power', 'display', 'system', 'performance', 'connections'];
const scopeAnchors = [...[...sections.map(s => s.toLowerCase()), 'all'].flatMap(scope => [scope, ...['all', ...areaOrder].map(area => scope + '/' + area)]), ...['Working','Partial','Planned'].flatMap(status=>['status-'+status.toLowerCase(),...features.filter(f=>f.status===status).map(f=>'status-'+status.toLowerCase()+'/'+capabilityKey(f.feature))])];
const architecture = [
  {id: 'context', name: 'Foundations', kind: 'Research context', detail: 'Methods, tools and sources.', domains: ['Foundations'], tiles: [['Documentation', 'document'], ['Source code', 'code'], ['Build environment', 'database'], ['Hardware notes', 'document']]},
  {id: 'hardware', name: 'PinePhone · A64', kind: 'Physical board', detail: 'The physical hardware target.', domains: ['Machine', 'Storage', 'Graphics', 'Interaction'], tiles: [['CPU', 'chip'], ['Memory', 'memory'], ['Display', 'display'], ['OV5640', 'camera']]},
  {id: 'kernel', name: 'XNU kernel & drivers', kind: 'Kernel space', detail: 'Core OS, device drivers and low-level services.', domains: ['Machine', 'Storage', 'Graphics', 'Interaction'], tiles: [['Mach', 'gear'], ['BSD', 'document'], ['IOKit', 'chip']]},
  {id: 'services', name: 'Services & frameworks', kind: 'User space', detail: 'System frameworks and services.', domains: ['Storage', 'Graphics', 'Interaction'], tiles: [['UIKit', 'cube'], ['CoreSurface', 'layers'], ['PhotoLibrary', 'database']]},
  {id: 'apps', name: 'Apps', kind: 'User space', detail: 'User applications and system apps.', domains: ['Graphics', 'Interaction'], tiles: [['SpringBoard', 'app'], ['Camera', 'camera'], ['Photos', 'photos']]},
];
const topics: Record<string, string> = {
  Foundations: 'Software · machines · source',
  Machine: 'Boot · memory · interrupts',
  Storage: 'Discovery · requests · persistence',
  Graphics: 'Surfaces · pixels · presentation',
  Interaction: 'Input · media · power',
  Method: 'Models · observation · evidence',
};
const architectureFocus: Record<string, string> = {
  Foundations: 'Foundations: identify the hardware and software.',
  Machine: 'Machine: hardware and the kernel.',
  Storage: 'Storage: devices, the kernel and system services.',
  Graphics: 'Graphics: from application pixels to the panel.',
  Interaction: 'Interaction: device events, services and apps.',
  Method: 'Method: evidence at every boundary.',
};
---
<figure class:list={['layerplate', {'with-capabilities': capabilities}]} data-layerplate data-domain="Foundations" aria-labelledby={`${id}-caption`}>
  {capabilities && <div class="scope-anchors" aria-hidden="true">{scopeAnchors.map(anchor => <span id={anchor}/>)}</div>}
  <figcaption class="sr-only" id={`${id}-caption`}>{capabilities ? 'Explore the system and its capabilities' : 'Read the system in layers'}</figcaption>
  <div class="layer-map">
  <div class="plate-head">
    {capabilities ? <h2>Explore the system</h2> : <span>Read the system in layers</span>}
    <span class="wireframe-key"><span aria-hidden="true">◇</span> Architecture × research</span>
  </div>
  {capabilities && <button type="button" class="focus-mobile" data-focus-jump hidden><span data-focus-mobile-title>Live viewfinder</span><span data-focus-mobile-level>Implementation 3/5 ↓</span></button>}
  <div class="layer-visual">
    <div id={`${id}-architecture`} data-layer-diagram="architecture">
      <p class="diagram-guide">One system. Six research paths.<span class="architecture-focus" data-tier-summary>{architectureFocus.Foundations}</span></p>
      <div class="layer-scene" aria-hidden="true">
        <div class="stack-drift"><div class="stack architecture-stack">
          <span class="wire-spine wire-spine-left"></span><span class="wire-spine wire-spine-right"></span>
          {architecture.map((tier, i) => (
            <a href={url(`status/#layer-${tier.id}`)} id={capabilities ? `layer-${tier.id}` : undefined} class:list={['layer', 'architecture-layer', {'context-layer': i === 0, 'is-related': true}]} data-layer={i} data-tier={tier.id} data-domain={sections[i]} data-research-domains={tier.domains.join(' ')} style={`--order:${i};--level:${4 - i}`} tabindex="-1" aria-label={`${tier.name}: explore ${sections[i]}`}>
              <span class="face-label"><strong>{tier.name}</strong><span class="tier-description">{tier.detail}</span><span class="tier-components">{tier.tiles.map(([name]) => name).join(" · ")}</span></span>
              <span class="callout-line"></span>
              <span class="layer-face">
                <span class="component-tiles" style={`--tiles:${tier.tiles.length}`}>
                  {tier.tiles.map(([name, icon]) => <span class="component-tile" data-component={`${tier.id}:${name}`}><span class="component-icon"><ArchitectureIcon name={icon}/></span><span>{name}</span></span>)}
                </span>
              </span>
            </a>
          ))}
          {capabilities && <svg class="lens-connectors" data-focus-connectors hidden aria-hidden="true"/>}
        </div></div>
        {capabilities && <div class="lens-callout" data-focus-callout hidden><strong data-focus-callout-title>Live viewfinder</strong><span data-focus-callout-level>Implementation 3/5</span></div>}
        <a href={url("status/#method")} class="method-rail" data-layer="5" data-domain="Method" tabindex="-1" aria-label="Method applies across every research domain"><span class="method-label"><span class="layer-dot"></span>Method</span></a>
      </div>
      <ol class="sr-only" aria-label="Conceptual architecture from bottom to top">{architecture.map(tier => <li>{tier.name}. {tier.kind}: {tier.detail} Components: {tier.tiles.map(([name]) => name).join(", ")}.</li>)}</ol>
    </div>
    <div class="layer-tabs" role={capabilities ? 'group' : 'tablist'} aria-label="Explore the six research domains">
      {sections.map((section, i) => (
        <button type="button" id={`${id}-tab-${i}`} role={capabilities ? undefined : 'tab'} aria-selected={capabilities ? undefined : String(i === 0)} aria-pressed={capabilities ? String(i === 0) : undefined} aria-controls={capabilities ? `${id}-features` : `${id}-panel-${i}`} tabindex={capabilities || i === 0 ? 0 : -1} data-layer-tab={i} data-domain={section} data-architecture-note={architectureFocus[section]}>
          <span class="layer-dot" aria-hidden="true"></span><span>{section}</span>
        </button>
      ))}
    </div>
    {capabilities && <button class="layer-motion" type="button" data-layer-motion aria-pressed="false" hidden>Pause motion</button>}
    <details class="diagram-notes">
      <summary>Reading this wireframe</summary>
      <p>The planes show the native route: physical board, adapted XNU kernel and drivers, services and frameworks, then SpringBoard and apps. The component tiles illustrate what belongs at each boundary. Plane colors match their linked research entries below; research domains can span several OS boundaries. Selecting a domain highlights the boundaries it studies.</p>
      <p>Foundations sits beneath the diagram as research context, not an operating-system component. Method spans every boundary. Connections are a reading guide; they do not establish runtime calls or certify that a feature works.</p>
      <p>XNU includes Mach, BSD and I/O Kit in its kernel environment. Apple’s Foundation framework belongs to userspace and is distinct from the atlas’s Foundations section.</p>
      <p>Architecture references: <a href="https://developer.apple.com/library/archive/documentation/Darwin/Conceptual/KernelProgramming/Architecture/Architecture.html">Apple’s kernel overview</a> and <a href="https://developer.apple.com/library/archive/documentation/Cocoa/Conceptual/CocoaFundamentals/WhatIsCocoa/WhatIsCocoa.html">iOS framework layers</a>. For the project’s distinct execution environments, read <a href={url('articles/three-machines/')}>the three machines</a>.</p>
    </details>
  </div>
  </div>
  <div class="layer-details">
    {capabilities ? <div class="capability-panel" id={`${id}-features`} role="region" aria-label="Capability details" tabindex="0">
      <StatusSpotlight id={id}/>
      <div class="capability-top"><span class="scope-heading"><span class="capability-kicker" data-scope-label>RESEARCH DOMAIN / 01</span><a class="scope-permalink" data-scope-permalink href={url("status/#foundations")} aria-label="Link to Foundations" title="Link to this selection">#</a></span><button type="button" class="show-all" data-show-all aria-pressed="false" aria-controls={`${id}-features`}>All {features.length} features <span aria-hidden="true">↗</span></button></div>
      {sections.map((section, i) => <div data-layer-detail={i} hidden={i !== 0}>
        <div class="capability-heading"><h3>{section}</h3><span class="capability-count"><span class="layer-dot" aria-hidden="true"></span>{features.filter(f => f.layers.includes(section)).length} related capabilities</span></div>
        <p class="domain-description">{sectionDescriptions[section]}</p>
      </div>)}
      <div data-all-heading hidden><div class="capability-heading"><h3>All capabilities</h3><span class="capability-count">{features.length} features</span></div><p class="domain-description">The complete reviewed snapshot. Select a research domain to follow its path through the system.</p></div>
      <div class="area-controls" data-area-controls hidden>
        <div class="area-intro"><span>Browse by area</span><span data-area-summary></span><button type="button" class="area-all" data-cap-area="all" data-area-label="All" aria-pressed="true" aria-controls={`${id}-features`}>All <span data-area-count></span></button></div>
        <div class="area-filters" role="group" aria-label="Filter capabilities by area">
          {areaOrder.map(area => <button type="button" data-cap-area={area} data-area-label={areaLabels[area]} aria-pressed="false" aria-controls={`${id}-features`}>{areaLabels[area]}<span data-area-count></span></button>)}
        </div>
      </div>
      <div class="capability-list">{features.map(feature => <CapabilityRow feature={feature}/>)}</div>
      <StatusSpotlight id={id} footer/>
      <div class="detail-links"><a data-domain-link href={url('library/#foundations')}>Read Foundations <span aria-hidden="true">↗</span></a><button class="expand-scores" type="button" data-expand-scores aria-expanded="false" aria-controls={`${id}-features`}>Expand all scores</button></div>
      <p class="score-disclaimer">Scores are editorial judgements. <a href={url('status/#snapshot')}>About this snapshot ↗</a></p>
      <p class="sr-only" role="status" data-capability-status></p>
    </div> : <>
    {sections.map((section, i) => (
      <div id={`${id}-panel-${i}`} role="tabpanel" aria-labelledby={`${id}-tab-${i}`} data-layer-detail={i} data-domain={section} hidden={i !== 0}>
        <div class="detail-heading"><span>{topics[section]}</span><span>{articles.filter(a => a.section === section).length} chapters</span></div>
        <p>{sectionDescriptions[section]}</p>
        <div class="detail-links"><a href={url('library/#' + section.toLowerCase())}>Read {section.toLowerCase()} <span aria-hidden="true">↗</span></a></div>
      </div>
    ))}
    </>}
  </div>
  <noscript><style is:inline>.layerplate .layer-tabs,.layerplate .show-all,.layerplate .expand-scores,.layerplate .area-controls{display:none}.layerplate .layer{pointer-events:none}.with-capabilities [data-layer-detail]{display:none!important}.with-capabilities [data-all-heading],.with-capabilities [data-capability]{display:block!important}.with-capabilities .capability-kicker{display:none}</style><p class="layer-fallback">Explore all six research domains in the <a href={url('library/')}>chapter index ↗</a>.</p></noscript>
</figure>

<style>
  .scope-anchors{position:absolute;top:0;left:0;pointer-events:none}.scope-anchors span{position:absolute;scroll-margin-top:110px}
  .layerplate{min-width:0;margin:0;position:relative}
  .plate-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:10px;padding-bottom:12px;border-bottom:1px solid var(--rule);font:11px var(--mono);color:var(--muted)}
  .wireframe-key{display:flex;align-items:center;gap:7px;font:9px var(--mono);color:var(--muted);white-space:nowrap}
  .wireframe-key>span{font-size:16px;color:var(--blue)}
  .diagram-guide{font-size:11px;line-height:1.5;color:var(--muted);min-height:32px;margin:12px 0 0}
  .architecture-focus{display:none}
  .layer-visual{min-width:0}
  .layer-map{container-type:inline-size}
  .layer-scene{--step:clamp(78px,14cqw,106px);--face-height:clamp(70px,22cqw,170px);height:calc(var(--step)*4 + 168px);position:relative;isolation:isolate;margin-top:10px}
  .stack-drift{position:absolute;inset:0}
  .stack{position:absolute;inset:0}
  .layer{--tint:var(--domain);position:absolute;left:0;right:30px;top:calc(68px + var(--level)*var(--step));height:70px;padding:0;border:0;background:none;text-align:left;cursor:pointer;color:var(--ink);z-index:calc(6 - var(--level));transition:opacity .3s}
  .layer-face{position:absolute;left:27%;top:0;width:54%;height:var(--face-height);display:block;border:1px solid color-mix(in srgb,var(--tint) 35%,var(--rule));border-radius:3px;background:linear-gradient(135deg,color-mix(in srgb,var(--tint) 5%,var(--surface)),color-mix(in srgb,var(--tint) 10%,var(--surface)));box-shadow:0 3px 0 color-mix(in srgb,var(--tint) 13%,var(--surface)),0 4px 0 color-mix(in srgb,var(--tint) 25%,var(--rule)),0 20px 25px -18px #23375a38;transform:matrix(1,-.22,.68,.55,0,0);transform-origin:0 0;transition:border-color .3s,box-shadow .3s,background .3s}
  .layer:not(.is-related) .layer-face{opacity:.48}
  .layer.is-related .layer-face{border-color:color-mix(in srgb,var(--tint) 65%,var(--rule))}
  .layer:hover .layer-face{box-shadow:0 3px 0 color-mix(in srgb,var(--tint) 25%,var(--surface)),0 4px 0 var(--tint),0 18px 26px -16px color-mix(in srgb,var(--tint) 35%,transparent)}
  .face-label{position:absolute;left:0;top:-6px;width:25%;display:flex;flex-direction:column;gap:7px}
  .face-label strong{font-size:clamp(11px,1.85cqw,15px);font-weight:620;line-height:1.3;letter-spacing:-.025em;background:var(--bg);width:fit-content;position:relative;z-index:1;padding-right:5px}
  .face-label .tier-components{display:none}
  .face-label>span{display:block;max-width:145px;color:var(--muted);font-size:clamp(10px,1.55cqw,12px);line-height:1.5;padding-right:8px}
  .callout-line{position:absolute;top:2px;left:0;width:25%;height:1px;background:var(--rule);z-index:-1}
  .callout-line:after{content:'';position:absolute;right:-3px;top:-3px;width:7px;height:7px;border-radius:50%;background:var(--tint)}
  .component-tiles{display:grid;grid-template-columns:repeat(var(--tiles),minmax(0,1fr));align-items:center;gap:clamp(7px,2cqw,20px);height:100%;padding:15px 6%}
  .component-tile{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;height:100%;min-width:0;border:1px solid color-mix(in srgb,var(--tint) 16%,var(--rule));border-radius:5px;background:var(--surface);box-shadow:0 3px 0 color-mix(in srgb,var(--tint) 8%,var(--bg)),0 4px 0 color-mix(in srgb,var(--tint) 14%,var(--rule)),0 9px 12px -8px #23375a50;font-size:clamp(11px,1.75cqw,14px);font-weight:530;white-space:nowrap}
  .component-tile>span:last-child{transform:scaleY(1.35)}
  .component-icon{display:block;width:clamp(24px,5.5cqw,42px);height:clamp(24px,5.5cqw,42px);color:color-mix(in srgb,var(--tint) 55%,var(--ink));transform:scaleY(1.35);filter:drop-shadow(0 3px 1px #23375a20)}
  .context-layer .layer-face{border-style:dashed;background:color-mix(in srgb,var(--tint) 3%,var(--bg));box-shadow:none}
  .context-layer .component-tile{border:0;box-shadow:none;background:none;color:var(--muted);font-size:clamp(10px,1.55cqw,12px);white-space:normal;text-align:center}
  .context-layer .component-icon{color:var(--muted);opacity:.7}
  .context-layer .face-label strong{color:color-mix(in srgb,var(--tint) 65%,var(--ink))}
  .wire-spine{position:absolute;top:68px;bottom:90px;border-left:1px dashed color-mix(in srgb,var(--foundations,#9880e8) 50%,var(--rule));pointer-events:none}
  .wire-spine-left{left:26%}.wire-spine-right{right:21%;top:0;bottom:178px}
  .method-rail{position:absolute;right:0;top:28px;bottom:60px;width:25px;border:0;padding:0;background:none;display:flex;align-items:center;justify-content:flex-end;color:var(--muted)}
  .method-rail:after{content:'';position:absolute;left:0;top:0;bottom:0;width:10px;border:1px solid var(--domain);border-left:0;border-radius:0 3px 3px 0}
  .method-label{display:flex;align-items:center;gap:8px;writing-mode:vertical-rl;transform:rotate(180deg);font:11px var(--sans);background:var(--bg);position:relative;z-index:1;padding:9px 0}
  .method-rail.is-active .method-label{color:var(--ink)}
  .layer-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin:4px 0 18px}
  .layer-tabs button{display:flex;align-items:center;justify-content:flex-start;gap:8px;min-height:38px;padding:7px 10px;background:transparent;border:1px solid transparent;border-radius:4px;font-size:12px;line-height:1.35;text-align:left}
  .layer-tabs button:hover{background:var(--surface)}
  .layer-tabs button:is([aria-selected="true"],[aria-pressed="true"]){border-color:color-mix(in srgb,var(--domain) 60%,var(--rule));background:color-mix(in srgb,var(--domain) 10%,var(--surface))}
  .layer-dot{width:7px;height:7px;border-radius:50%;background:var(--domain);flex:none}
  .layer-details{min-height:117px;padding-top:15px;border-top:1px solid var(--rule)}
  .detail-heading{display:flex;align-items:baseline;justify-content:space-between;gap:12px;color:var(--muted);font:10px/1.6 var(--mono)}
  .detail-heading>span:last-child{white-space:nowrap}
  .layer-details p{font-size:13px;line-height:1.6;margin:8px 0}
  .layer-details a{font-size:12px;color:var(--blue);display:inline-flex;gap:12px;align-items:center}
  .layer-details a:hover{text-decoration:underline;text-underline-offset:4px}
  .detail-links{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
  .diagram-notes{font-size:11px;line-height:1.65;color:var(--muted);margin:8px 0 16px}
  .diagram-notes summary{cursor:pointer;color:var(--blue);width:fit-content}
  .diagram-notes p{margin:12px 0;max-width:65ch}
  .diagram-notes a{text-decoration:underline;text-underline-offset:3px}
  .layer-motion{float:right;background:transparent;border:0;padding:5px 0 5px 12px;color:var(--muted);font-size:10px}
  .layer-motion:hover{color:var(--blue)}
  [data-motion-paused] .stack-drift{animation-play-state:paused!important}
  [data-motion-paused] .layer{animation:none!important}
  .with-capabilities{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(0,1fr);gap:48px;align-items:start;scroll-margin-top:104px}
  .with-capabilities[data-domain="All"]{--domain:var(--blue)}
  .layer-map{min-width:0}
  .with-capabilities .plate-head{border:0;padding:0;gap:12px}
  .with-capabilities .plate-head h2{font:620 26px/1.2 var(--sans);letter-spacing:-.04em;color:var(--ink)}
  .with-capabilities .diagram-guide{font-size:12px;margin-top:10px;min-height:18px}
  .with-capabilities .layer-tabs{grid-template-columns:repeat(6,minmax(0,1fr));margin-top:8px}
  .with-capabilities .layer-tabs button{font-size:11px;padding:7px 8px;gap:6px}
  .with-capabilities .layer-tabs button{border-color:var(--rule);background:var(--surface);min-height:42px}
  .with-capabilities .layer-tabs button[aria-pressed="true"]{border-color:var(--domain);background:color-mix(in srgb,var(--domain) 8%,var(--surface))}
  .with-capabilities>.layer-details{min-height:0;padding:0;border:0}
  .capability-panel{min-width:0;border:1px solid color-mix(in srgb,var(--rule) 45%,transparent);border-top:3px solid var(--domain);border-radius:2px;padding:22px 24px 18px;background:color-mix(in srgb,var(--surface) 90%,var(--bg));transition:border-color .25s,background .25s}
  .capability-panel:focus-visible{outline:3px solid var(--blue);outline-offset:4px}
  .capability-top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:10px}
  .capability-kicker{font:10px/1.5 var(--mono);color:var(--muted)}
  .capability-heading{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:14px}
  .capability-heading h3{font-size:28px;letter-spacing:-.035em;margin:0;line-height:1.2}
  .capability-count{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--muted)}
  .capability-panel .domain-description{font-size:13px;line-height:1.7;margin:0}
  .show-all,.expand-scores{background:transparent;border:0;color:var(--blue);font-size:11px;line-height:1.5;padding:5px 0;white-space:nowrap}
  .show-all span{margin-left:8px}.show-all[aria-pressed="true"]{color:var(--muted)}
  .show-all:hover,.expand-scores:hover{text-decoration:underline;text-underline-offset:4px}
  .scope-heading{display:flex;align-items:center;gap:8px}
  .capability-top .scope-permalink{font:15px var(--mono);color:var(--muted);padding:4px 6px;border-radius:3px}
  .scope-permalink:hover{color:var(--blue);background:var(--bg)}
  .area-controls{border-block:1px solid var(--rule);margin-top:20px;padding:14px 0 16px}
  .capability-panel .area-intro{display:flex;justify-content:space-between;gap:12px;margin:0 0 11px;color:var(--muted);font-size:11px}
  .area-intro [data-area-summary]{margin-left:auto}
  .area-all{padding:4px 6px;border:0;background:none;color:var(--blue);font-size:11px;min-height:28px;white-space:nowrap}
  .area-all:hover,.area-all[aria-pressed="true"]{text-decoration:underline;text-underline-offset:3px}
  .area-filters{display:flex;flex-wrap:wrap;gap:6px}
  .area-filters button{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--rule);border-radius:4px;background:var(--bg);font-size:11px;line-height:1.5;min-height:36px}
  .area-filters button span{font:10px var(--mono);color:var(--muted)}
  .area-filters button[aria-pressed="true"]{border-color:var(--domain);background:color-mix(in srgb,var(--domain) 10%,var(--surface));box-shadow:inset 0 -1px 0 var(--domain)}
  .area-filters button:hover{border-color:var(--domain)}
  .capability-list{display:block}
  .with-capabilities .detail-links{padding-top:18px;gap:10px}
  .with-capabilities .score-disclaimer{font-size:10px;line-height:1.7;margin:12px 0 0;color:var(--muted)}
  .score-disclaimer a{font-size:10px;display:inline;text-decoration:underline;text-underline-offset:3px}
  .with-capabilities .layer-fallback{grid-column:1 / -1}
  @keyframes detail-in{from{opacity:.5;transform:translateY(5px)}to{opacity:1;transform:none}}
  .layer-fallback{font-size:13px}.layer-fallback a{text-decoration:underline}
  .is-entering .layer{animation:unstack .9s var(--ease-out) both;animation-delay:calc(var(--order)*70ms)}
  .in-view .stack-drift{animation:stack-float 8s ease-in-out 1.4s infinite}
  .layerplate:is(:hover,:focus-within) .stack-drift{animation-play-state:paused}
  @keyframes unstack{from{transform:translateY(calc((2 - var(--level))*15px));opacity:1}to{transform:none;opacity:1}}
  @keyframes stack-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
  @media screen and (min-width:1001px) and (min-height:1000px){.with-capabilities>.layer-map{position:sticky;top:110px}}
  @media(max-width:1200px){.with-capabilities{gap:28px;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr)}.with-capabilities .plate-head h2{font-size:24px}.capability-panel{padding:20px}.with-capabilities .layer-tabs{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:1000px){.with-capabilities{grid-template-columns:minmax(0,1fr);max-width:780px;margin:auto;gap:24px}.with-capabilities .layer-tabs{grid-template-columns:repeat(6,minmax(0,1fr))}.with-capabilities .diagram-notes{margin-bottom:0}.with-capabilities .layer-details{margin:0}}
  @container(max-width:500px){.layer-scene{--step:102px;height:568px;--face-height:80px}.layer{top:calc(62px + var(--level)*var(--step));right:24px}.layer-face{left:29%;width:52%}.face-label{width:27%;top:-10px}.face-label>span{font-size:10px}.face-label strong{font-size:12px}.face-label .tier-description{display:none}.face-label .tier-components{display:block;font-size:11px;line-height:1.45}.context-layer .face-label .tier-components{display:none}.context-layer .face-label .tier-description{display:block;font-size:11px}.component-tiles{gap:6px;padding:9px 5%}.component-tile{gap:0}.component-tile>span:last-child{display:none}.component-icon{width:25px;height:25px}.context-layer .component-tile{font-size:9px}.context-layer .component-icon{width:22px;height:22px}.callout-line{display:none}.wire-spine{top:62px;bottom:87px}.wire-spine-right{top:18px;bottom:123px}.method-rail{top:20px;bottom:63px}.with-capabilities .layer-tabs{grid-template-columns:repeat(3,minmax(0,1fr))}.wireframe-key{font-size:8px}}
  @media(max-width:600px){.layer-tabs{gap:4px;margin-top:8px}.layer-tabs button{font-size:11px;min-height:40px;padding:7px 6px;gap:6px}.detail-heading{font-size:9px}.layer-details{min-height:132px}}
  @media(max-width:420px){.capability-panel{padding:18px 16px}.capability-heading{gap:10px}.capability-heading h3{font-size:25px}.capability-kicker{font-size:9px}.show-all{font-size:10px}}
  @media(prefers-reduced-motion:reduce){.with-capabilities [data-layer-detail]{animation:none}}
  @media print{.with-capabilities{display:block}.with-capabilities>.layer-map{position:static}.with-capabilities>.layer-details{margin-top:20px}.diagram-switch,.show-all,.expand-scores,.area-controls{display:none}.with-capabilities [data-layer-detail]{display:none!important}.with-capabilities [data-all-heading],.with-capabilities :global([data-capability]){display:block!important}.with-capabilities .capability-kicker{display:none}}
  @media(prefers-reduced-motion:reduce){.is-entering .layer,.in-view .stack-drift{animation:none}.layer{transition:none}}
</style>

<script>
  for (const plate of document.querySelectorAll<HTMLElement>('[data-layerplate]')) {
    const layers = [...plate.querySelectorAll<HTMLAnchorElement>('[data-layer]')];
    const tabs = [...plate.querySelectorAll<HTMLButtonElement>('[data-layer-tab]')];
    const panels = [...plate.querySelectorAll<HTMLElement>('[data-layer-detail]')];
    const tiers = [...plate.querySelectorAll<HTMLElement>('[data-tier]')];
    const expandedDetails = plate.classList.contains('with-capabilities');
    const features = [...plate.querySelectorAll<HTMLElement>('[data-capability]')];
    const allButton = plate.querySelector<HTMLButtonElement>('[data-show-all]');
    const scoresButton = plate.querySelector<HTMLButtonElement>('[data-expand-scores]');
    const areaButtons = [...plate.querySelectorAll<HTMLButtonElement>('[data-cap-area]')];
    let selected = 0, selectedArea = 'all';
    let entryTimer: number | undefined;
    const updateScoresButton = () => {
      if (!scoresButton) return;
      const expanded = features.filter(f => !f.hidden).every(f => f.querySelector<HTMLDetailsElement>('details')!.open);
      scoresButton.setAttribute('aria-expanded', String(expanded));
      scoresButton.textContent = expanded ? 'Collapse shown scores' : 'Expand shown scores';
    };
    const enter = () => {
      window.clearTimeout(entryTimer); plate.classList.remove('is-entering');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      void plate.offsetWidth; plate.classList.add('is-entering');
      entryTimer = window.setTimeout(() => plate.classList.remove('is-entering'), 1400);
    };
    type Selection = {focus?: boolean; align?: boolean; area?: string; record?: 'push' | 'replace'; hash?: string};
    const select = (index: number, options: Selection = {}) => {
      if (plate.dataset.statusLens) plate.dispatchEvent(new Event('atlas:clear-status-focus'));
      const previous = selected, previousArea = selectedArea;
      selected = index;
      const domain = index < 0 ? 'All' : tabs[index].dataset.domain!;
      plate.dataset.domain = domain;
      plate.querySelector<HTMLElement>('[data-tier-summary]')!.textContent = index < 0 ? 'All research domains, from hardware to applications.' : tabs[index].dataset.architectureNote!;
      layers.forEach(layer => layer.classList.toggle('is-active', Number(layer.dataset.layer) === index));
      tiers.forEach(tier => tier.classList.toggle('is-related', index < 0 || domain === 'Foundations' || domain === 'Method' || tier.dataset.researchDomains?.split(' ').includes(domain)));
      tabs.forEach((tab, i) => { tab.setAttribute(expandedDetails ? 'aria-pressed' : 'aria-selected', String(i === index)); tab.tabIndex = expandedDetails || i === Math.max(0,index) ? 0 : -1; });
      panels.forEach((panel, i) => { panel.hidden = i !== index; });
      if (expandedDetails) {
        const scope = features.filter(feature => index < 0 || feature.dataset.capabilityLayers!.split(' ').includes(domain));
        let area = options.area ?? (domain === 'Interaction' ? 'input' : 'all');
        if (area !== 'all' && !scope.some(feature => feature.dataset.capabilityArea === area)) area = domain === 'Interaction' ? 'input' : 'all';
        selectedArea = area;
        plate.querySelector<HTMLElement>('[data-area-controls]')!.hidden = scope.length <= 6 && area === 'all';
        areaButtons.forEach(button => {
          const count = button.dataset.capArea === 'all' ? scope.length : scope.filter(f => f.dataset.capabilityArea === button.dataset.capArea).length;
          button.hidden = !count;
          button.setAttribute('aria-pressed', String(button.dataset.capArea === area));
          button.querySelector('[data-area-count]')!.textContent = String(count);
        });
        features.forEach(feature => { feature.hidden = !scope.includes(feature) || (area !== 'all' && feature.dataset.capabilityArea !== area); });
        const count = features.filter(feature => !feature.hidden).length;
        const areaLabel = areaButtons.find(button => button.dataset.capArea === area)?.dataset.areaLabel;
        plate.querySelector<HTMLElement>('[data-area-summary]')!.textContent = `${count} of ${scope.length} shown`;
        allButton!.setAttribute('aria-pressed', String(index < 0));
        plate.querySelector<HTMLElement>('[data-all-heading]')!.hidden = index >= 0;
        plate.querySelector<HTMLElement>('[data-scope-label]')!.textContent = index < 0 ? 'REVIEWED SNAPSHOT' : 'RESEARCH DOMAIN / ' + String(index + 1).padStart(2,'0');
        plate.querySelector<HTMLElement>('.capability-panel')!.setAttribute('aria-label', domain + ' capabilities' + (area === 'all' ? '' : ': ' + areaLabel));
        plate.querySelector<HTMLElement>('[data-capability-status]')!.textContent = `${count} of ${scope.length} capabilities shown for ${domain}${area === 'all' ? '' : ', ' + areaLabel}.`;
        const link = plate.querySelector<HTMLAnchorElement>('[data-domain-link]')!;
        link.href = link.href.split('#')[0] + (index < 0 ? '' : '#' + domain.toLowerCase());
        link.textContent = (index < 0 ? 'Browse research chapters' : 'Read ' + domain) + ' ↗';
        const canonical = '#' + domain.toLowerCase() + (domain === 'Interaction' || area !== 'all' ? '/' + area : '');
        const permalink = plate.querySelector<HTMLAnchorElement>('[data-scope-permalink]')!;
        permalink.href = permalink.href.split('#')[0] + canonical;
        permalink.setAttribute('aria-label', `Link to ${domain}${area === 'all' ? '' : ' / ' + areaLabel}`);
        if (options.record && location.hash !== (options.hash ?? canonical)) {
          history[options.record === 'push' ? 'pushState' : 'replaceState'](null, '', options.hash ?? canonical);
        }
        updateScoresButton();
      }
      if (options.focus && index >= 0) tabs[index].focus({preventScroll: true});
      if (options.align && expandedDetails && (previous !== index || previousArea !== selectedArea) && plate.getBoundingClientRect().top < 80) {
        window.scrollTo({top: window.scrollY + plate.getBoundingClientRect().top - 104, behavior: 'instant'});
      }
    };
    allButton?.addEventListener('click', () => select(-1, {align: true, area: 'all', record: 'push', hash: '#all'}));
    areaButtons.forEach(button => button.addEventListener('click', () => select(selected, {area: button.dataset.capArea, align: true, record: 'push'})));
    scoresButton?.addEventListener('click', () => {
      const expand = scoresButton.getAttribute('aria-expanded') !== 'true';
      features.filter(feature => !feature.hidden).forEach(feature => { feature.querySelector<HTMLDetailsElement>('details')!.open = expand; });
      updateScoresButton();
    });
    features.forEach(feature => feature.querySelector('details')!.addEventListener('toggle', updateScoresButton));
    if (expandedDetails) {
      const restoreHash = (align = true) => {
        let hash: string;
        try { hash = decodeURIComponent(location.hash.slice(1)).toLowerCase(); } catch { return false; }
        const [scope, area] = hash.split('/');
        const tier = layers.find(layer => 'layer-' + layer.dataset.tier === scope);
        const index = scope === 'all' || scope === 'feature-matrix' ? -1 : tier ? Number(tier.dataset.layer) : tabs.findIndex(tab => tab.dataset.domain!.toLowerCase() === scope);
        if (index < 0 && scope !== 'all' && scope !== 'feature-matrix') return false;
        select(index, {area});
        if (align) requestAnimationFrame(() => window.scrollTo({top: window.scrollY + plate.getBoundingClientRect().top - 104, behavior: 'instant'}));
        return true;
      };
      if (!restoreHash() && !location.hash.startsWith('#status-')) select(0);
      window.addEventListener('hashchange', () => { if (!location.hash) select(0); else restoreHash(); });
      plate.addEventListener('atlas:restore-status-overview', () => select(selected, {area: selectedArea}));
    }
    const motion = plate.querySelector<HTMLButtonElement>('[data-layer-motion]');
    if (motion) {
      motion.hidden = false;
      motion.addEventListener('click', () => {
        const paused = plate.toggleAttribute('data-motion-paused');
        motion.setAttribute('aria-pressed', String(paused)); motion.textContent = paused ? 'Resume motion' : 'Pause motion';
      });
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const updateMotion = () => { motion.disabled = reduced.matches; motion.textContent = reduced.matches ? 'Reduced motion' : plate.hasAttribute('data-motion-paused') ? 'Resume motion' : 'Pause motion'; };
      reduced.addEventListener('change', updateMotion); updateMotion();
    }
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, {align: true, record: 'push', hash: '#' + tab.dataset.domain!.toLowerCase()}));
      tab.addEventListener('keydown', event => {
        const next = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? (i + 1) % tabs.length
          : event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? (i + tabs.length - 1) % tabs.length
          : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : -1;
        if (next < 0) return;
        event.preventDefault(); event.stopPropagation(); select(next, {focus: true, align: true, record: 'replace'});
      });
    });
    layers.forEach(layer => {
      const index = Number(layer.dataset.layer);
      layer.addEventListener('pointerenter', event => {
        if (event.pointerType === 'mouse' && !expandedDetails && !plate.contains(document.activeElement)) select(index);
      });
      layer.addEventListener('click', event => {
        if (!expandedDetails || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault(); select(index, {align: true, record: 'push', hash: new URL(layer.href).hash});
      });
    });
    let inViewport = false;
    const updateVisibility = () => {
      const active = inViewport && !plate.closest<HTMLElement>('[data-hero-slide]')?.inert;
      plate.classList.toggle('in-view', active);
      if (active && !plate.dataset.entered) { plate.dataset.entered = 'true'; enter(); }
    };
    const observer = new IntersectionObserver(entries => { inViewport = entries[0].isIntersecting; updateVisibility(); }, {threshold: .1});
    plate.closest('[data-hero-slide]')?.addEventListener('atlas:hero-visibility', updateVisibility); observer.observe(plate);
  }
</script>
