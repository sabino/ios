---
import {url, evidenceById} from '../lib/content';
interface Props {
  feature: {
    feature: string;
    status: string;
    functionality: number;
    implementation: number;
    environment: string;
    evidence?: string;
    note: string;
    layers: string[];
    category: string;
  };
  expanded?: boolean;
}
const {feature: f, expanded = false} = Astro.props;
const dots = (n: number) => Array.from({length: 5}, (_, i) => i < n);
const statusClass = 'st-' + f.status.toLowerCase().replace(/[^a-z]+/g, '-');
---
<article class="capability-row" data-capability={f.feature} data-capability-layers={f.layers.join(' ')} hidden={!f.layers.includes('Foundations')}>
  <div class="feat-title"><span class:list={['status-chip', statusClass]}>{f.status}</span><h4>{f.feature}</h4></div>
  <p class="feat-note">{f.note}</p>
  <div class="feat-meta">
    <span class="feature-category">{f.category}</span>
    <span class="mono">{f.environment}</span>
    {f.evidence ? <a class="evidence-link" href={url('evidence/' + f.evidence + '/')} title={evidenceById(f.evidence)?.title}>{f.evidence} ↗</a> : <span class="record-pending">Development observation · record pending</span>}
  </div>
  <details class="feature-scores" open={expanded}>
    <summary>Scores &amp; evidence<span class="sr-only"> for {f.feature}</span></summary>
    <div class="scores">
      {[['Functionality', f.functionality], ['Implementation', f.implementation]].map(([label, score]) => (
        <div class="score" role="img" aria-label={label + ': ' + score + ' out of 5'}>
          <span class="score-label" aria-hidden="true">{label}</span>
          <span class="dots" aria-hidden="true">{dots(Number(score)).map(on => <i class={on ? 'on' : ''}/>)}</span>
        </div>
      ))}
    </div>
    {f.evidence ? <p class="record-detail"><a href={url('evidence/' + f.evidence + '/')}>{f.evidence} · {evidenceById(f.evidence)?.title} ↗</a></p> : <p class="record-detail">Reported by the development line. A formal evidence record has not yet been published.</p>}
  </details>
</article>

<style>
  .capability-row{padding:20px 0;border-bottom:1px solid var(--rule)}
  .capability-row:last-child{border-bottom:0}
  .feat-title{display:flex;align-items:center;gap:12px;margin-bottom:9px;flex-wrap:wrap}
  .feat-title h4{margin:0;font-size:16px;line-height:1.4;letter-spacing:-.015em}
  .feat-note{margin:0 0 10px;font-size:14px;line-height:1.65;color:var(--ink)}
  .feat-meta{display:flex;flex-wrap:wrap;gap:5px 18px;align-items:center}
  .feat-meta .mono,.record-pending,.feature-category{font:10px/1.7 var(--mono);color:var(--muted)}
  .evidence-link{font:11px/1.7 var(--mono);color:var(--blue)}
  a:hover{text-decoration:underline;text-underline-offset:3px}
  .status-chip{font:10px/1.3 var(--mono);text-transform:uppercase;letter-spacing:.025em;border-radius:999px;padding:6px 10px;border:1px solid var(--rule);white-space:nowrap}
  .st-working{background:color-mix(in srgb,#1f9d55 12%,transparent);border-color:color-mix(in srgb,#1f9d55 48%,var(--rule))}
  .st-partial{background:color-mix(in srgb,#c47d12 12%,transparent);border-color:color-mix(in srgb,#c47d12 48%,var(--rule))}
  .st-experimental{background:color-mix(in srgb,#b5862b 12%,transparent);border-color:color-mix(in srgb,#b5862b 48%,var(--rule))}
  .st-planned,.st-n-a{color:var(--muted)}
  .feature-scores{margin-top:11px}
  .feature-scores summary{font-size:12px;color:var(--blue);cursor:pointer;min-height:28px;width:fit-content;padding:3px 0}
  .feature-scores summary::marker{font-size:10px}
  .scores{display:flex;flex-wrap:wrap;gap:14px 32px;justify-content:space-between;border:1px solid color-mix(in srgb,var(--rule) 45%,transparent);background:color-mix(in srgb,var(--bg) 65%,transparent);padding:14px 16px;border-radius:4px;margin:8px 0 10px}
  .score{display:flex;align-items:center;gap:14px}
  .score-label{font-size:11px;color:var(--muted)}
  .dots{display:inline-flex;gap:4px}
  .dots i{width:7px;height:7px;border-radius:50%;border:1px solid var(--muted);display:inline-block}
  .dots i.on{background:var(--ink);border-color:var(--ink)}
  .record-detail{font-size:11px;line-height:1.7;color:var(--muted);margin:0}
  .record-detail a{color:var(--blue)}
  @media(max-width:600px){.feat-title{gap:7px 10px}.feat-title h4{font-size:15px}.feat-note{font-size:13px}.scores{gap:12px;padding:12px}.score{gap:10px}.score-label{font-size:10px}}
  @media print{.feature-scores::details-content{display:block}.feature-scores summary{display:none}}
</style>
