---
const {name} = Astro.props;
---
<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'app' && <><rect x="8" y="8" width="24" height="24" rx="6" fill="currentColor" opacity=".16"/><rect x="8" y="8" width="24" height="24" rx="6"/><path d="M14 15h12M14 20h12M14 25h7"/></>}
  {name === 'camera' && <><path d="M7 12h7l3-4h8l3 4h5v20H7z" fill="currentColor" opacity=".12"/><path d="M7 12h7l3-4h8l3 4h5v20H7z"/><circle cx="21" cy="22" r="7"/><circle cx="21" cy="22" r="4"/><path d="M10 16h3"/></>}
  {name === 'photos' && <><rect x="6" y="10" width="27" height="23" rx="3" fill="currentColor" opacity=".1"/><rect x="6" y="10" width="27" height="23" rx="3"/><path d="m10 27 7-8 6 5 4-4 6 7M11 6h22a4 4 0 0 1 4 4v18"/><circle cx="27" cy="16" r="2"/></>}
  {name === 'cube' && <><path d="m20 5 14 8v15l-14 8-14-8V13z" fill="currentColor" opacity=".13"/><path d="m20 5 14 8v15l-14 8-14-8V13zM6 13l14 8 14-8M20 21v15M13 9l14 8v9"/></>}
  {name === 'layers' && <><path d="m20 6 15 8-15 8-15-8z" fill="currentColor" opacity=".14"/><path d="m20 6 15 8-15 8-15-8zM5 21l15 8 15-8M5 28l15 8 15-8"/></>}
  {name === 'database' && <><path d="M9 11v19c0 6 22 6 22 0V11" fill="currentColor" opacity=".12"/><ellipse cx="20" cy="11" rx="11" ry="5"/><path d="M9 11v19c0 6 22 6 22 0V11M9 18c0 6 22 6 22 0M9 24c0 6 22 6 22 0"/></>}
  {name === 'gear' && <><path d="m17 5 6 0 1 5 4 2 5-1 3 5-4 4 0 4 3 4-3 5-5-2-4 2-1 4h-6l-1-5-4-2-5 1-3-5 4-4v-4l-3-4 3-5 5 2 4-2z" fill="currentColor" opacity=".12"/><path d="m17 5 6 0 1 5 4 2 5-1 3 5-4 4 0 4 3 4-3 5-5-2-4 2-1 4h-6l-1-5-4-2-5 1-3-5 4-4v-4l-3-4 3-5 5 2 4-2z"/><circle cx="20" cy="21" r="6"/></>}
  {name === 'chip' && <><rect x="10" y="10" width="20" height="20" rx="2" fill="currentColor" opacity=".15"/><rect x="10" y="10" width="20" height="20" rx="2"/><rect x="14" y="14" width="12" height="12" rx="1"/><path d="M14 5v5m6-5v5m6-5v5M14 30v5m6-5v5m6-5v5M5 14h5m-5 6h5m-5 6h5M30 14h5m-5 6h5m-5 6h5"/></>}
  {name === 'memory' && <><path d="M4 12h32v17H4z" fill="currentColor" opacity=".12"/><path d="M4 12h32v17H4zM8 29v4m6-4v4m6-4v4m6-4v4m6-4v4"/><path d="M8 16h6v8H8zM18 16h6v8h-6zM28 16h4v8h-4z"/></>}
  {name === 'display' && <><rect x="5" y="7" width="30" height="22" rx="2" fill="currentColor" opacity=".1"/><rect x="5" y="7" width="30" height="22" rx="2"/><path d="M9 11h22v14H9zM20 29v6m-8 0h16M12 21l5-5 5 4 5-6"/></>}
  {(name === 'document' || name === 'code') && <><path d="M10 5h14l7 7v23H10z" fill="currentColor" opacity=".1"/><path d="M10 5h14l7 7v23H10zM24 5v8h7"/>{name === 'code' ? <path d="m17 19-4 4 4 4m8-8 4 4-4 4m-3-9-3 11"/> : <path d="M15 19h11M15 24h11M15 29h7"/>}</>}
</svg>
<style>svg{width:100%;height:100%;display:block}</style>
