---
import LayerStack from './LayerStack.astro';
import DeviceShowcase from './DeviceShowcase.astro';
import ResearchStory from './ResearchStory.astro';
import {articles, evidence, url} from '../lib/content';
import capabilities from '../data/capabilities.json';
---
<section class="home-hero" data-home-hero aria-label="Explore the iPhone OS Research Atlas" aria-roledescription="carousel">
  <div class="hero-slides" id="home-hero-slides">
    <div class="hero-slide is-active" data-hero-slide data-slide-title="Read the system" role="group" aria-roledescription="slide" aria-label="1 of 4: Read the system">
      <div class="hero-copy">
        <div class="eyebrow"><span class="small-cross" aria-hidden="true">+</span> Independent systems research</div>
        <h1>iPhone OS,<br/><span>under the surface.</span></h1>
        <p class="hero-dek">A systems study of early iPhone OS on open mobile hardware. Native execution, stock applications and physical acceptance—traced to a fixed research record.</p>
        <div class="hero-actions"><a class="button primary" href={url('paper/')}>Read the paper <span aria-hidden="true">↗</span></a><a class="text-link" href={url('summary/')}>The study in plain language <span aria-hidden="true">→</span></a></div>
        <div class="hero-meta"><span><strong>{articles.length}</strong> chapters</span><span><strong>{evidence.length}</strong> evidence records</span><span>1.1.4 + 3.1.3</span></div>
      </div>
      <LayerStack/>
    </div>
    <div class="hero-slide" data-hero-slide data-slide-title="What runs" role="group" aria-roledescription="slide" aria-label="2 of 4: What runs">
      <div class="hero-copy">
        <div class="eyebrow"><span class="small-cross" aria-hidden="true">+</span> What runs <span class="hero-edition">/ 3.1.3</span></div>
        <h2>Old software.<br/><span>New ground.</span></h2>
        <p class="hero-dek">iPhone OS 3.1.3 now runs natively on the PinePhone. Explore the accepted touch, Camera, Photos and power-off workflow, alongside the separate 1.1.4 profiles.</p>
        <div class="hero-actions"><a class="button primary" href={url('status/')}>See what runs <span aria-hidden="true">↗</span></a><a class="text-link" href={url('articles/three-machines/')}>Meet the three environments <span aria-hidden="true">→</span></a></div>
        <p class="hero-snapshot"><span class="mono">REVIEWED SNAPSHOT / {capabilities.updated}</span>The October 7 owner test accepts Camera/Photos and reopening a photo after cold power-on. Ordinary restart and USB pairing retain separate gates.</p>
      </div>
      <DeviceShowcase variant="hero"/>
    </div>
    <div class="hero-slide" data-hero-slide data-slide-title="Live camera" role="group" aria-roledescription="slide" aria-label="3 of 4: Live camera">
      <div class="hero-copy">
        <div class="eyebrow"><span class="small-cross" aria-hidden="true">+</span> A working viewfinder</div>
        <h2>From sensor<br/><span>to viewfinder.</span></h2>
        <p class="hero-dek">The stock Camera app shows live frames from the PinePhone’s sensor. Follow the path through capture, pixel conversion and image ownership to the screen.</p>
        <div class="hero-actions"><a class="button primary" href={url('articles/camera-preview/')}>Follow the camera path <span aria-hidden="true">↗</span></a><a class="text-link" href={url('status/#interaction/camera')}>Camera capabilities <span aria-hidden="true">→</span></a></div>
        <p class="hero-snapshot"><span class="mono">PHYSICAL PINEPHONE / 7E18</span>Stock 3.1.3 Camera uses original kernel providers. Accepted preview and capture do not establish a measured preview frame rate.</p>
      </div>
      <ResearchStory kind="camera"/>
    </div>
    <div class="hero-slide" data-hero-slide data-slide-title="Saved photos" role="group" aria-roledescription="slide" aria-label="4 of 4: Saved photos">
      <div class="hero-copy">
        <div class="eyebrow"><span class="small-cross" aria-hidden="true">+</span> Beyond the preview</div>
        <h2>A photograph.<br/><span>A fresh boot.</span></h2>
        <p class="hero-dek">A shutter press is only the beginning. In the accepted 3.1.3 daily test, the owner saved a photograph, powered the phone off and reopened it after cold power-on.</p>
        <div class="hero-actions"><a class="button primary" href={url('articles/camera-stills/')}>Follow a saved photograph <span aria-hidden="true">↗</span></a><a class="text-link" href={url('evidence/E51/')}>Inspect the daily test <span aria-hidden="true">→</span></a></div>
        <p class="hero-snapshot"><span class="mono">REVIEWED SNAPSHOT / {capabilities.updated}</span>The 1600 × 1200 output is resampled from 640 × 480 acquisition. More output pixels do not establish more captured detail.</p>
      </div>
      <ResearchStory kind="photo"/>
    </div>
  </div>
  <button class="hero-arrow hero-prev" type="button" data-hero-prev aria-label="Previous slide" aria-controls="home-hero-slides" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7M7 12h14"/></svg></button>
  <button class="hero-arrow hero-next" type="button" data-hero-next aria-label="Next slide" aria-controls="home-hero-slides" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 5 7 7-7 7M17 12H3"/></svg></button>
  <div class="hero-controls" data-hero-controls hidden>
    <div class="hero-pagination" role="group" aria-label="Choose a feature">
      <button type="button" data-hero-go="0" aria-pressed="true"><span class="hero-page-number">01</span> Read the system</button>
      <button type="button" data-hero-go="1" aria-pressed="false"><span class="hero-page-number">02</span> What runs</button>
      <button type="button" data-hero-go="2" aria-pressed="false"><span class="hero-page-number">03</span> Live camera</button>
      <button type="button" data-hero-go="3" aria-pressed="false"><span class="hero-page-number">04</span> Saved photos</button>
    </div>
    <button type="button" class="motion-toggle" data-hero-motion aria-label="Pause motion" aria-pressed="false"><span data-motion-symbol aria-hidden="true">Ⅱ</span><span data-motion-label>Pause motion</span></button>
  </div>
  <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-hero-announcement></p>
</section>

<style>
  .home-hero{position:relative;padding:28px 0 0}
  .hero-slides{margin:0 58px;touch-action:pan-y pinch-zoom}
  .hero-slide{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:clamp(28px,4vw,66px);align-items:center;min-height:626px;padding:10px 0 28px}
  .home-hero.is-ready .hero-slides{display:grid}
  .home-hero.is-ready .hero-slide{grid-area:1/1;min-width:0}
  .home-hero.has-navigated .hero-slide{transition:opacity .4s var(--ease-out),transform .5s var(--ease-out),visibility .4s}
  .home-hero.is-ready .hero-slide[aria-hidden="true"]{visibility:hidden;opacity:0;transform:translateX(calc(var(--hero-direction,1)*22px));pointer-events:none}
  .hero-slide.is-active{visibility:visible;opacity:1;transform:none}
  .hero-slide[aria-hidden="true"] :global(*){animation-play-state:paused!important}
  .hero-copy{min-width:0;max-width:560px}
  h1,h2{font-size:clamp(46px,4.6vw,70px);line-height:1.04;letter-spacing:-.055em;margin:24px 0;max-width:11ch}
  h1>span,h2>span{color:var(--blue)}
  .hero-dek{font-size:16px;line-height:1.75;max-width:43ch;margin-bottom:28px}
  .hero-actions{gap:18px}
  .hero-meta{font-size:10px;gap:16px;margin-top:32px}
  .hero-edition{margin-left:auto}
  .hero-snapshot{margin:28px 0 0;border-top:1px solid var(--rule);padding-top:17px;font-size:11px;line-height:1.8;color:var(--muted);max-width:51ch}
  .hero-snapshot .mono{display:block;font-size:10px;margin-bottom:7px}
  .hero-arrow{position:absolute;z-index:2;top:calc(50% - 26px);width:42px;height:58px;border:1px solid var(--rule);border-radius:5px;background:var(--surface);display:grid;place-items:center;transition:background .2s,border-color .2s,transform .2s}
  .hero-prev{left:0}.hero-next{right:0}
  .hero-arrow svg{width:21px;fill:none;stroke:currentColor;stroke-width:1.4}
  .hero-arrow:hover{background:var(--tint);border-color:var(--blue);transform:translateX(2px)}
  .hero-prev:hover{transform:translateX(-2px)}
  .hero-controls{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:72px;margin:0 58px;border-top:1px solid var(--rule)}
  .hero-pagination{display:flex;align-items:center;gap:26px;flex-wrap:wrap}
  .hero-pagination button{position:relative;display:flex;align-items:center;gap:10px;padding:20px 0;border:0;background:none;font-size:12px;color:var(--muted)}
  .hero-pagination button:before{content:'';position:absolute;top:-1px;left:0;right:0;height:2px;background:var(--blue);transform:scaleX(0);transform-origin:left;transition:transform .35s var(--ease-out)}
  .hero-pagination button[aria-pressed="true"]{color:var(--ink)}
  .hero-pagination button[aria-pressed="true"]:before{transform:scaleX(1)}
  .hero-page-number{font:10px var(--mono);color:var(--muted)}
  .motion-toggle{padding:8px 0;border:0;background:transparent;display:flex;gap:7px;align-items:center;font-size:10px;color:var(--muted);white-space:nowrap}
  .motion-toggle [data-motion-symbol]{font-size:14px}
  .home-hero.is-motion-paused :global(*){animation-play-state:paused!important;transition:none!important}
  @media(max-width:1100px) and (min-width:901px){.hero-slides,.hero-controls{margin-inline:44px}.hero-arrow{width:32px;height:50px}.hero-slide{gap:28px}h1,h2{font-size:50px}.hero-dek{font-size:14px}.eyebrow{font-size:9px}.hero-meta{gap:9px;font-size:9px}.hero-actions{gap:14px}.hero-actions .text-link{font-size:11px}.hero-pagination{gap:20px}}
  @media(max-width:900px){.home-hero{padding-top:32px}.hero-slide{grid-template-columns:minmax(0,1fr);gap:32px;min-height:0;align-content:start}.hero-slides{margin:0 50px}.hero-copy{max-width:650px}h1,h2{font-size:60px;max-width:14ch}.hero-dek{max-width:52ch}.hero-meta{margin-top:24px}.hero-arrow{top:244px}.hero-controls{margin-inline:50px}.hero-slide :global(.layerplate){width:min(100%,540px);margin:auto}}
  @media(max-width:600px){.home-hero{padding-top:96px}.hero-slides{margin:0}.hero-slide{gap:22px;padding-bottom:18px}.hero-copy{padding:0 2px}h1,h2{font-size:clamp(40px,11.5vw,56px);margin:20px 0;max-width:12ch}.eyebrow{font-size:9px;gap:8px}.hero-dek{font-size:14px;line-height:1.75;margin-bottom:21px}.hero-actions{gap:16px}.hero-actions .text-link{font-size:11px}.hero-meta{font-size:9px;gap:12px;margin-top:22px;padding-top:14px}.hero-arrow{top:17px;bottom:auto;width:38px;height:42px}.hero-controls{position:absolute;top:0;left:0;right:0;margin:0;justify-content:center;min-height:78px;padding:0 48px;border-top:0;border-bottom:1px solid var(--rule)}.hero-pagination{gap:18px}.hero-pagination button{padding:23px 0;font-size:10px;gap:6px}.hero-page-number{display:none}.motion-toggle{position:absolute;right:0;top:82px;font-size:9px;padding:4px;min-width:30px;min-height:30px;justify-content:center}.motion-toggle [data-motion-label]{display:none}.motion-toggle [data-motion-symbol]{font-size:12px}.hero-snapshot{margin-top:24px;font-size:11px}}
  @media(max-width:600px){
    .hero-slide{gap:18px}
    .hero-slide .hero-copy{display:contents}
    .hero-slide .eyebrow{grid-row:1}
    .hero-slide h1,.hero-slide h2{grid-row:2;font-size:clamp(36px,10.2vw,46px);max-width:none;margin:0 0 8px}
    .hero-slide :global(.layerplate),.hero-slide :global(.showcase),.hero-slide :global(.research-story){grid-row:3}
    .hero-slide .hero-dek{grid-row:4;margin:0}
    .hero-slide .hero-actions{grid-row:5}
    .hero-slide .hero-meta,.hero-slide .hero-snapshot{grid-row:6;margin-top:4px}
  }
  @media(max-width:900px){.home-hero.is-ready .hero-slide[aria-hidden="true"]{display:none}.hero-controls{gap:14px}.hero-pagination{gap:20px}.hero-pagination button{font-size:11px}}
  @media(max-width:600px){.home-hero{padding-top:132px}.hero-controls{min-height:112px;align-items:center}.hero-pagination{display:grid;grid-template-columns:1fr 1fr;gap:0 14px;width:100%;max-width:320px}.hero-pagination button{padding:13px 0;font-size:10px;white-space:nowrap}.hero-pagination button:before{top:auto;bottom:3px}.hero-arrow{top:36px}.motion-toggle{top:113px}}
  @media(prefers-reduced-motion:reduce){.hero-slide,.hero-arrow,.hero-pagination button:before{transition:none!important}.motion-toggle{display:none}.home-hero :global(*){animation:none!important}}
  @media print{.hero-slides{display:block!important;margin:0}.hero-slide{display:grid!important;visibility:visible!important;opacity:1!important;transform:none!important}.hero-arrow,.hero-controls{display:none!important}}
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-home-hero]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-hero-slide]')];
    const pages = [...hero.querySelectorAll<HTMLButtonElement>('[data-hero-go]')];
    const previous = hero.querySelector<HTMLButtonElement>('[data-hero-prev]')!;
    const next = hero.querySelector<HTMLButtonElement>('[data-hero-next]')!;
    const announcement = hero.querySelector<HTMLElement>('[data-hero-announcement]')!;
    let current = 0;
    const show = (index: number, announce = true) => {
      if (announce) hero.classList.add('has-navigated');
      const nextIndex = (index + slides.length) % slides.length;
      hero.style.setProperty('--hero-direction', index < current ? '-1' : '1');
      const focusLeaving = slides[current].contains(document.activeElement);
      current = nextIndex;
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === current);
        slide.setAttribute('aria-hidden', String(i !== current));
        slide.inert = i !== current;
        slide.dispatchEvent(new Event('atlas:hero-visibility'));
      });
      pages.forEach((button, i) => button.setAttribute('aria-pressed', String(i === current)));
      if (focusLeaving) pages[current].focus({preventScroll: true});
      if (announce) announcement.textContent = `${slides[current].dataset.slideTitle} — slide ${current + 1} of ${slides.length}`;
    };
    show(0, false);
    hero.classList.add('is-ready');
    previous.hidden = false; next.hidden = false;
    hero.querySelector<HTMLElement>('[data-hero-controls]')!.hidden = false;
    previous.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));
    pages.forEach((button, i) => button.addEventListener('click', () => show(i)));
    hero.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('[role="tablist"],input,select,textarea')) return;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault(); show(current + (event.key === 'ArrowLeft' ? -1 : 1));
      }
    });
    let touch: {x: number; y: number} | null = null;
    hero.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'touch' || !event.isPrimary || (event.target as HTMLElement).closest('button,a')) return;
      touch = {x: event.clientX, y: event.clientY};
    });
    hero.addEventListener('pointerup', (event) => {
      if (!touch) return;
      const dx = event.clientX - touch.x, dy = event.clientY - touch.y;
      touch = null;
      if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1));
    });
    hero.addEventListener('pointercancel', () => { touch = null; });
    const motion = hero.querySelector<HTMLButtonElement>('[data-hero-motion]')!;
    motion.addEventListener('click', () => {
      const paused = hero.classList.toggle('is-motion-paused');
      if (paused) hero.querySelectorAll('.is-entering').forEach(el => el.classList.remove('is-entering'));
      motion.setAttribute('aria-pressed', String(paused));
      motion.setAttribute('aria-label', paused ? 'Resume motion' : 'Pause motion');
      motion.querySelector('[data-motion-label]')!.textContent = paused ? 'Resume motion' : 'Pause motion';
      motion.querySelector('[data-motion-symbol]')!.textContent = paused ? '▷' : 'Ⅱ';
    });
  }
</script>
