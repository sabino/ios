---
import Base from '../layouts/Base.astro';
import {Content,frontmatter} from '../../content/edition.md';
import {url} from '../lib/content';
import '../styles/publication.css';
---
<Base title={frontmatter.title} description={frontmatter.description}>
<header class="page-heading"><span class="section-number">DATED PUBLICATION RECORD</span><h1>{frontmatter.title}</h1><p>{frontmatter.description}</p><a class="text-link" href={url('paper/')}>Open the paper →</a></header>
<article class="prose companion-prose"><Content/></article>
</Base>
