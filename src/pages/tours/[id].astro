---
import Base from '../../layouts/Base.astro';import {tours,articleBySlug,url} from '../../lib/content';
export function getStaticPaths(){return tours.map(tour=>({params:{id:tour.id},props:{tour}}))}
const {tour}=Astro.props;
---
<Base title={tour.title} description={tour.description}><div class="page-heading"><span class="section-number">A GUIDED READING PATH / {tour.slugs.length} STOPS</span><h1>{tour.title}</h1><p>{tour.description}</p></div><ol class="tour-stops">{tour.slugs.map((slug:string,i:number)=>{const a=articleBySlug(slug);return <li data-domain={a.section}><span class="stop-number">{String(i+1).padStart(2,'0')}</span><a href={url('articles/'+slug+'/')}><span class="mono">{a.section}</span><h2>{a.title}</h2><p>{a.description}</p><span class="text-link">Read chapter →</span></a></li>})}</ol><p class="tour-end">You can return to this path at any time. Each chapter also links directly to related concepts and its supporting evidence.</p></Base>
