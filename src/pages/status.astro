---
import Base from '../layouts/Base.astro';
import {url} from '../lib/content';
import LayerStack from '../components/LayerStack.astro';
import caps from '../data/capabilities.json';
const features = caps.domains.flatMap(domain => domain.features);
const statuses = ['Working', 'Partial', 'Experimental', 'Planned', 'N/A'].filter(status => features.some(feature => feature.status === status));
const snapshotDate = new Intl.DateTimeFormat('en-GB', {day:'2-digit', month:'short', year:'numeric', timeZone:'UTC'}).format(new Date(caps.updated));
---
<Base title="Capability status" description="Explore the reported capabilities of the native iPhone OS port on the physical PinePhone, their current limits and supporting evidence." wide={true}>
<div class="status-page">
  <section class="status-overview" aria-labelledby="status-title">
    <div class="overview-copy">
      <h1 id="status-title">What runs today.</h1>
      <p>iPhone OS 1.1.4 on the physical PinePhone. Explore each capability and the evidence behind it.</p>
      <a class="snapshot-link" href={url('status/#snapshot')}>Reviewed snapshot · <time datetime={caps.updated}>{snapshotDate}</time> <span aria-hidden="true">↗</span></a>
    </div>
    <dl class="status-counts" aria-label="Reported capability counts">
      {statuses.map(status => <div data-status={status}><dt><span class="count-dot" aria-hidden="true"></span>{status}</dt><dd>{features.filter(feature => feature.status === status).length}</dd></div>)}
    </dl>
  </section>

  <section class="status-explorer" id="capabilities" aria-label="Capability explorer">
    <span id="feature-matrix" class="legacy-anchor" aria-hidden="true"></span>
    <LayerStack id="status-layers" capabilities/>
  </section>

  <section class="status-context" aria-labelledby="software-title">
    <div class="context-intro"><h2 id="software-title">Software &amp; direction</h2><p>Builds, devices and the path ahead.</p></div>
    <div class="software-variants">
      <span class="context-label">Software variants</span>
      <div class="variant-list">
        {caps.systems.map(system => (
          <details class="variant">
            <summary><strong>{system.id === 'n45' ? 'N45AP · iPod touch' : 'M68AP · iPhone'}</strong><span class="mono">{system.os} · {system.build}</span></summary>
            <p>{system.reach}</p>
            <p class="variant-env">Environments: {system.environments.join(' · ')}</p>
            <p class="variant-scores">Functionality {system.functionality}/5 · Implementation {system.implementation}/5</p>
          </details>
        ))}
      </div>
    </div>
    <div class="roadmap">
      <span class="context-label">Road to 3GS</span>
      <ol class="road">
        {caps.roadmap.map(step => (
          <li class:list={['road-step',step.state]}>
            <details>
              <summary><strong>{step.os.replace('iPhone OS ', '')}</strong><span>{step.stage}</span></summary>
              <p>{step.note}</p><p class="mono">{step.chip} · {step.targets}</p>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <details class="snapshot-notes" id="snapshot">
    <summary>About this snapshot and its limits <span class="mono">{caps.updated}</span></summary>
    <div class="snapshot-body">
      <p>{caps.provenance}</p>
      <p><strong>Functionality:</strong> {caps.scale.functionality} <strong>Implementation:</strong> {caps.scale.implementation} Both are editorial ratings from 0 to 5.</p>
      <p>Research domains can share a capability: storage, graphics and input often cross the same boundaries. “All 22 features” counts each capability once.</p>
      <p>Read the <a href={url('method/')}>research method</a>, the <a href={url('evidence/')}>fixed evidence ledger</a> or <a href={url('articles/three-machines/')}>the three execution environments</a> for the scope of each claim.</p>
    </div>
  </details>
</div>
<script>
  const revealSnapshot = () => {
    if (location.hash === '#snapshot') document.querySelector<HTMLDetailsElement>('#snapshot')!.open = true;
  };
  revealSnapshot();
  window.addEventListener('hashchange', revealSnapshot);
</script>
<style>
  .status-page{max-width:1440px;margin:auto}
  .status-overview{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:40px;padding:36px 0 22px;border-bottom:1px solid var(--rule)}
  .overview-copy h1{font-size:clamp(34px,3.4vw,49px);letter-spacing:-.05em;line-height:1.06;margin:0 0 7px}
  .overview-copy>p{font-size:16px;line-height:1.6;color:var(--muted);max-width:76ch;margin:0 0 3px}
  .snapshot-link{font:11px/1.8 var(--mono);color:var(--muted)}
  .snapshot-link:hover{color:var(--blue)}
  .snapshot-link>span{margin-left:5px}
  .status-counts{display:flex;margin:0;gap:0;align-self:center}
  .status-counts>div{position:relative;display:flex;flex-direction:column-reverse;gap:2px;min-width:82px;padding:0 22px;border-left:1px solid var(--rule)}
  .status-counts>div:first-child{border:0;padding-left:15px}
  .status-counts>div:last-child{padding-right:0}
  .status-counts dt{font-size:12px;color:var(--muted)}
  .status-counts dd{font-size:28px;line-height:1.2;letter-spacing:-.04em;font-weight:620;margin:0}
  .count-dot{width:7px;height:7px;border-radius:50%;background:var(--muted);position:absolute;top:11px;left:9px}
  [data-status="Working"] .count-dot{background:#199b73}[data-status="Partial"] .count-dot{background:#b29512}[data-status="Planned"] .count-dot{background:var(--blue)}
  .status-counts>div:first-child .count-dot{left:0}
  .status-explorer{padding:28px 0 32px;position:relative;scroll-margin-top:100px}
  .legacy-anchor{position:absolute;top:0;scroll-margin-top:100px}
  .status-context{display:grid;grid-template-columns:.72fr 1.2fr 1.18fr;gap:30px;border-top:1px solid var(--rule);padding:30px 0;align-items:start}
  .context-intro h2{font-size:20px;line-height:1.2;letter-spacing:-.03em;margin:4px 0 8px}
  .context-intro p{font-size:12px;color:var(--muted);margin:0}
  .software-variants,.roadmap{border-left:1px solid var(--rule);padding-left:30px;min-width:0}
  .context-label{font-size:11px;color:var(--muted);display:block;margin-bottom:12px}
  .variant-list{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .variant summary{cursor:pointer;list-style:none;position:relative;padding-right:12px}
  .variant summary::-webkit-details-marker{display:none}
  .variant summary::after{content:'+';position:absolute;right:0;top:0;color:var(--muted);font:14px var(--mono)}
  .variant[open] summary::after{content:'−'}
  .variant strong{display:block;font-size:13px;line-height:1.5;font-weight:600}
  .variant .mono{display:block;font-size:9px;color:var(--muted);margin-top:4px}
  .variant p{font-size:12px;line-height:1.65;margin:14px 0 0}
  .variant .variant-env,.variant .variant-scores{font-size:10px;color:var(--muted)}
  .road{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;list-style:none;margin:0;padding:0}
  .road-step{position:relative;min-width:0}
  .road-step:not(:last-child)::after{content:'→';position:absolute;right:-20px;top:0;font-size:17px;color:var(--muted)}
  .road summary{list-style:none;cursor:pointer;position:relative;padding-left:24px}
  .road summary::-webkit-details-marker{display:none}
  .road summary::before{content:'';position:absolute;left:0;top:3px;width:12px;height:12px;border:1px solid var(--muted);border-radius:50%}
  .road .done summary::before{border-color:var(--blue);background:var(--blue);box-shadow:inset 0 0 0 3px var(--bg)}
  .road strong{font-size:14px;display:block;line-height:1.4}
  .road summary>span{display:block;color:var(--muted);font-size:11px;margin-top:3px}
  .road .done summary>span{color:var(--blue)}
  .road p{font-size:12px;line-height:1.65;margin:14px 0 0;overflow-wrap:anywhere}
  .road .mono{font-size:10px;color:var(--muted)}
  .road:has(details[open]){grid-template-columns:1fr;gap:14px}
  .road:has(details[open]) .road-step::after{display:none}
  .road:has(details[open]) summary{display:flex;align-items:baseline;gap:12px}
  .road:has(details[open]) summary>span{margin:0}
  .road:has(details[open]) p{margin:9px 0 0 24px}
  .snapshot-notes{border-top:1px solid var(--rule);padding:18px 0;margin-bottom:20px;scroll-margin-top:108px}
  .snapshot-notes summary{font-size:12px;cursor:pointer;color:var(--muted);width:fit-content}
  .snapshot-notes summary .mono{font-size:10px;margin-left:14px}
  .snapshot-body{max-width:90ch;padding:18px 0 0;font-size:13px;line-height:1.75;color:var(--muted)}
  .snapshot-body a{color:var(--blue);text-decoration:underline;text-underline-offset:3px}
  @media(max-width:1200px){.status-overview{gap:24px}.status-counts>div{min-width:72px;padding-right:16px}.status-context{grid-template-columns:1fr 1fr}.context-intro{grid-column:1/-1}.software-variants{padding-left:0;border:0}}
  @media(max-width:800px){.status-overview{grid-template-columns:1fr;gap:22px;padding-top:28px}.status-counts{width:100%}.status-counts>div{flex:1;padding-left:26px}.status-counts>div:first-child{padding-left:15px}.status-explorer{padding-top:24px}.status-context{gap:20px}.software-variants,.roadmap{grid-column:1/-1;border:0;padding:0}.roadmap{padding-top:18px;border-top:1px solid var(--rule)}.variant-list{gap:24px}.road{gap:30px}.road-step:not(:last-child)::after{right:-23px}.context-intro p{font-size:13px}}
  @media(max-width:380px){.overview-copy h1{font-size:33px}.overview-copy>p{font-size:14px}.status-counts>div{min-width:0;padding:0 10px 0 22px}.status-counts dd{font-size:25px}.status-counts dt{font-size:10px}.snapshot-notes summary .mono{display:block;margin:6px 0 0 14px}.variant strong{font-size:12px}}
</style>
</Base>
