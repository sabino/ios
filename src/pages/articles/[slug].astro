---
import Base from '../../layouts/Base.astro';
import Neighborhood from '../../components/Neighborhood.astro';
import JourneyTrack from '../../components/JourneyTrack.astro';
import reading from '../../data/reading.json';
import {articles,evidence,sources,publication,url,articleBySlug,neighbors,readingMinutes,environments,envKey} from '../../lib/content';
import {injectEvidence,peekCard,glyph} from '../../lib/evidence-cards';
export function getStaticPaths(){return articles.map(article=>({params:{slug:article.slug},props:{article}}))}
const {article}=Astro.props;
const prose=injectEvidence(await article.compiled(),article.slug);
const cited=article.evidence.map((id:string)=>evidence.find(e=>e.id===id)!);const external=sources.filter(s=>article.sources.includes(s.id));
const citation=`iPhone OS Research Atlas contributors. “${article.title}.” iPhone OS Research Atlas, edition ${publication.edition}, ${publication.date}. https://sabino.pro/ios/articles/${article.slug}/ (source snapshot ${publication.sourceRevision.slice(0,7)}).`;
const continuation=(reading as any)[article.slug];const next=articleBySlug(continuation.next)!;const previous=articles.find(a=>a.order===article.order-1);
const inDomain=articles.filter(a=>a.section===article.section),domainPosition=inDomain.findIndex(a=>a.slug===article.slug)+1;
const restart=next.order<article.order;const pad=(n:number)=>String(n).padStart(2,'0');
const citedEnvironments=environments.filter(env=>cited.some(e=>e.environment===env));
---
<Base title={article.title} description={article.description} domain={article.section}>
<div class="chapter" data-domain={article.section}>
<div class="article-topline"><a class="domain-link" href={url('library/#'+article.section.toLowerCase())}><i class="domain-dot" aria-hidden="true"/>{article.section}</a><span>CHAPTER {pad(article.order)} / {articles.length}</span><span>{readingMinutes(article)} MIN READ</span></div>
<header class="article-heading"><p class="chapter-kicker"><span class="chapter-badge">{pad(article.order)}</span><span>{article.section} · {domainPosition} of {inDomain.length} in this domain</span></p><h1>{article.title}</h1><p>{article.description}</p><div class="article-tools"><span>Edition {publication.edition} · {publication.date}</span><button data-copy-citation={citation}>Copy citation</button><button data-print>Print chapter</button></div></header>
<div class="article-layout has-context"><aside class="article-rail"><nav class="toc" aria-label="On this page"><p class="mono">IN THIS CHAPTER</p>{article.headings.filter((h:any)=>h.depth===2).map((h:any)=><a href={'#'+h.slug}>{h.text}</a>)}<a class="toc-end" href="#up-next">Up next</a><a class="toc-end" href="#evidence">Evidence appendix</a><a class="toc-end toc-map" href="#context-rail">Chapter map</a></nav><div class="rail-note"><span class="mono">READING CONTEXT</span><p>Measured results retain their original environment. A model result is not a hardware result.</p><a href={url('method/')}>How to read the evidence ↗</a></div></aside>
<div class="article-body"><article class="prose article-prose" set:html={prose}/>

<section class="chapter-end" id="up-next" aria-labelledby="up-next-title">
 <a class="up-next" data-domain={next.section} href={url(`articles/${next.slug}/`)}>
  <span class="up-next-kicker"><span class="mono">{restart?'FULL CIRCLE · RETURN TO':'UP NEXT'} · CHAPTER {pad(next.order)}</span><span class="up-next-domain"><i class="domain-dot" aria-hidden="true"/>{next.section}</span></span>
  <h2 id="up-next-title">{next.title}</h2>
  <p class="up-next-question">{continuation.why}</p>
  <p class="up-next-desc">{next.description}</p>
  <span class="up-next-cta"><span class="up-next-button">Continue reading <span aria-hidden="true">→</span></span><span class="mono">{readingMinutes(next)} MIN READ</span></span>
 </a>
 <div class="chapter-progress"><JourneyTrack current={article.slug}/>{previous&&<a class="prev-link" href={url(`articles/${previous.slug}/`)}><span aria-hidden="true">←</span> Previous · {previous.title}</a>}</div>
 <aside class="open-question"><span class="section-number">WHAT REMAINS OPEN</span><p>{continuation.open}</p><a class="text-link" href={url('timeline/#frontier')}>Place this question in the research timeline →</a></aside>
</section>

<section id="evidence" class="chapter-appendix" aria-labelledby="appendix-title">
 <header class="appendix-head"><span class="section-number">REFERENCE APPENDIX</span><h2 id="appendix-title">The evidence behind this chapter</h2><p>Each record keeps its environment, method and limit. Expand a card to inspect captured values in place, or open the full record for source excerpts and provenance.</p><p class="env-legend">{citedEnvironments.map(env=><span data-env={envKey(env)} set:html={glyph(env)+`<span>${env}</span>`}/>)}</p></header>
 <div class="appendix-cards" set:html={cited.map((e:any)=>peekCard(e.id,{from:article.slug})).join('')}/>
 <div class="appendix-grid">
  <section class="branch-out"><h3>Connected chapters</h3><div>{neighbors(article.slug).map(a=><a data-domain={a.section} href={url('articles/'+a.slug+'/')}><span class="branch-meta"><i class="domain-dot" aria-hidden="true"/>{a.section} · {pad(a.order)}</span><strong>{a.title}</strong></a>)}</div><a class="text-link" href={url('map/?focus='+article.slug)}>Locate this chapter on the concept map ↗</a></section>
  <section class="public-context"><h3>Public context</h3><ul class="source-list">{external.map(s=><li><a href={s.url}>{s.title} ↗</a><p>{s.scope}</p></li>)}</ul></section>
 </div>
 <section class="citation-box" id="citation"><span class="mono">CITE THIS CHAPTER</span><p>{citation}</p><a href={url('sources/#provenance')}>Review source provenance and access limits →</a></section>
</section>
<nav class="chapter-pagination" aria-label="Adjacent chapters">{previous?<a href={url('articles/'+previous.slug+'/')}><small>← PREVIOUS CHAPTER</small><strong>{previous.title}</strong></a>:<span/>}<a href={url('articles/'+next.slug+'/')}><small>{restart?'RETURN TO THE START →':'NEXT CHAPTER →'}</small><strong>{next.title}</strong></a></nav>
</div>

<aside class="context-rail" id="context-rail" aria-labelledby="context-title" data-context-rail>
 <div class="context-sheet">
  <div class="context-head"><h2 id="context-title" class="mono">YOU ARE HERE</h2><button class="context-close" type="button" data-context-close aria-label="Close the chapter map">✕</button></div>
  <Neighborhood focus={{kind:'chapter',slug:article.slug}} from={article.slug}/>
  <a class="context-full text-link" href={url('map/?focus='+article.slug)}>Open in the full concept map ↗</a>
  <JourneyTrack current={article.slug}/>
  <a class="context-next" data-domain={next.section} href={url(`articles/${next.slug}/`)}><span class="mono">{restart?'RETURN TO':'UP NEXT'} · {pad(next.order)}</span><strong>{next.title}</strong><span aria-hidden="true">→</span></a>
 </div>
</aside>
</div>
<button class="context-fab" type="button" aria-controls="context-rail" aria-expanded="false" data-context-open><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="2.6"/><circle cx="3.5" cy="5" r="1.6"/><circle cx="3.5" cy="15" r="1.6"/><circle cx="16.5" cy="6" r="1.6"/><circle cx="16.5" cy="14" r="1.6"/><path d="M5 5.6 8 8.8M5 14.4 8 11.2M15 6.6l-2.6 2.4M15 13.4l-2.6-2.4"/></svg><span>Chapter map</span></button>
</div>
<script src="../../lib/evidence-peek.ts"></script><script src="../../lib/neighborhood.ts"></script>
</Base>
