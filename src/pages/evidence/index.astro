---
import Base from '../../layouts/Base.astro';
import EvidenceAtlas from '../../components/EvidenceAtlas.astro';
import {evidence, sections, url} from '../../lib/content';
---
<Base title="Evidence Atlas" description={`${evidence.length} scoped research records by category, environment and reviewed source snapshot, with linked observations, limits and chapter relationships.`}>
  <header class="ea-heading"><div><h1>Evidence Atlas</h1><p>{evidence.length} records. {sections.length} research paths. Every claim keeps its environment and its limits.</p></div><a href={url('timeline/')}>Read the research timeline ↗</a></header>
  <EvidenceAtlas/>
  <details class="ea-provenance"><summary>About the records and their provenance</summary><p>These are curated reports from private research, with selected captures, source excerpts and document hashes. Hashes identify the reviewed material; they do not independently verify the observations. Review dates identify this editorial record, not the time each experiment ran.</p><a href={url('sources/#provenance')}>Read the provenance policy ↗</a></details>
</Base>
