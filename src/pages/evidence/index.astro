---
import Base from '../../layouts/Base.astro';import {evidence,url,envKey} from '../../lib/content';import {glyph} from '../../lib/evidence-cards';
const environments=['All','Physical PinePhone','PinePhone QEMU','iPod reference','Synthetic probe','Static inspection'];
---
<Base title="Evidence ledger" description="Twenty-eight scoped research records: observations, methods, environments and the limits of each finding."><div class="page-heading"><span class="section-number">THE EXPERIMENTAL RECORD</span><h1>What we can say.<br/><span>And why.</span></h1><p>Every result belongs to a particular experiment. The environment and the limit travel with the claim.</p></div><div class="ledger-notice"><strong>A public record of reported findings.</strong><p>These records expose selected capture data and source excerpts from private research, not a complete public reproduction package. Document hashes identify the reviewed source records. They do not independently verify the observations.</p><a href={url('sources/#provenance')}>Read the provenance policy ↗</a></div><div class="filter-bar" role="group" aria-label="Filter evidence by environment">{environments.map((env,i)=><button data-filter-group="evidence" data-filter={env} aria-pressed={i===0} data-env={i?envKey(env):undefined}>{i>0&&<Fragment set:html={glyph(env)}/>}{env}</button>)}</div><p class="filter-count mono" data-filter-count="evidence" role="status">{evidence.length} records shown</p><div class="ledger-head" aria-hidden="true"><span>RECORD</span><span>OBSERVATION</span><span>ENVIRONMENT / REVIEW</span></div><div class="ledger">{evidence.map(e=><a class="ledger-row" href={url('evidence/'+e.id+'/')} data-filter-item="evidence" data-category={e.environment} data-env={envKey(e.environment)}><span class="evidence-id"><Fragment set:html={glyph(e.environment)}/>{e.id}</span><div><h2>{e.title}</h2><p>{e.observation}</p><span class="ledger-exhibits">{e.exhibits.length} exhibits · {e.excerpts.length} source excerpts · {e.exhibits.some(x=>x.kind==='image')?'image capture included':'captured values inside'}</span></div><div class="ledger-meta"><span>{e.environment}</span><time>{e.reviewedOn}</time><span>Inspect record ↗</span></div></a>)}</div></Base>
